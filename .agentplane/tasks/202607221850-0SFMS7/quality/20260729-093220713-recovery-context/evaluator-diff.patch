+    try {
+      persisted = await supervisePersistedWorkflowEpisode({
+        decision: current,
+        git_root: input.command.resolvedProject.gitRoot,
+        task_revision: null,
+        execute: async ({ operation: invoked }) =>
+          await executeDirectOperation({ input, operation: invoked }),
+        refresh: decision,
+      });
+    } catch {
