+      status: started === 0 ? "succeeded" : "failed",
+      observed_postconditions: started === 0 ? ["task_status_doing"] : [],
+      detail: `recorded direct task start for ${operation.params.taskId}`,
+      exit_code: started,
+    };
+  }
