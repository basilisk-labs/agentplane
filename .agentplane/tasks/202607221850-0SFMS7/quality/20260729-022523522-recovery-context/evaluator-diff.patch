+    changed_files: 1,
+    diff_lines: 0,
+    no_progress_episodes: 0,
+  },
+  stop: null,
+  digest: "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+} as const;
+
+function decision(opts: {
+  id: string;
+  code: string;
