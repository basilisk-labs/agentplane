{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentplane.org/schemas/agent-semantic-payload.schema.json",
  "title": "Agent semantic payload (EVALUATOR, implementation)",
  "description": "Copy work_order_id from the issued WorkOrder. Return only this payload. The CLI binds it to that immutable episode and supplies its service fields. Keep summary short and report each finding once.",
  "definitions": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "number",
      "const": 1
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "repository_write",
        "documentation",
        "source_code",
        "tests",
        "public_api",
        "schema",
        "dependencies",
        "ci",
        "release_metadata",
        "security_boundary"
      ]
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    }
  },
  "type": "object",
  "properties": {
    "work_order_id": {
      "$ref": "#/definitions/__schema0"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "needs_context",
        "failed"
      ]
    },
    "summary": {
      "$ref": "#/definitions/__schema0"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claimed_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "$ref": "#/definitions/__schema0"
          },
          "claimed_status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "details": {
            "allOf": [
              {
                "$ref": "#/definitions/__schema0"
              }
            ]
          }
        },
        "required": [
          "check",
          "claimed_status"
        ],
        "additionalProperties": false
      }
    },
    "blocker": {
      "type": "object",
      "properties": {
        "summary": {
          "$ref": "#/definitions/__schema0"
        },
        "recommended_action": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema0"
            }
          ]
        },
        "scope_extension_request": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "$ref": "#/definitions/__schema1"
                },
                "rationale": {
                  "$ref": "#/definitions/__schema0"
                },
                "scope_roots": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema0"
                  }
                },
                "repository_effects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema2"
                  }
                }
              },
              "required": [
                "schema_version",
                "rationale",
                "scope_roots",
                "repository_effects"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "$ref": "#/definitions/__schema1"
                },
                "rationale": {
                  "$ref": "#/definitions/__schema0"
                },
                "scope_roots": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema0"
                  }
                },
                "repository_effects": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema2"
                  }
                }
              },
              "required": [
                "schema_version",
                "rationale",
                "scope_roots",
                "repository_effects"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "knowledge_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "knowledge_request"
        },
        "query": {
          "$ref": "#/definitions/__schema0"
        },
        "reason": {
          "$ref": "#/definitions/__schema0"
        },
        "desired_kind": {
          "type": "string",
          "enum": [
            "any",
            "wiki",
            "source",
            "fact",
            "entity",
            "edge"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "task_context"
          ]
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "query",
        "reason",
        "desired_kind",
        "scope",
        "blocking"
      ],
      "additionalProperties": false
    },
    "canonical_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "allOf": [
              {
                "$ref": "#/definitions/__schema3"
              }
            ]
          },
          "kind": {
            "$ref": "#/definitions/__schema3"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "rework",
            "blocked",
            "human_review"
          ]
        },
        "missing_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residual_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery_context": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema0"
            }
          ]
        }
      },
      "required": [
        "verdict",
        "missing_tests",
        "hidden_assumptions",
        "residual_risks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "work_order_id",
    "status",
    "summary",
    "findings",
    "uncertainty"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocker"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_context"
          }
        }
      },
      "then": {
        "required": [
          "knowledge_request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "verdict": {
                "enum": [
                  "pass",
                  "rework"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "verdict": {
                "const": "human_review"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "required": [
              "recovery_context"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "canonical_outputs"
        ]
      }
    }
  ],
  "examples": [
    {
      "work_order_id": "copy-the-issued-work-order-id",
      "status": "blocked",
      "summary": "The required input is unavailable.",
      "findings": [],
      "uncertainty": [],
      "blocker": {
        "summary": "Describe the concrete missing input."
      },
      "review": {
        "verdict": "blocked",
        "missing_tests": [],
        "hidden_assumptions": [],
        "residual_risks": []
      }
    }
  ]
}
