+function implementationPlanDigest(plan: TaskPlanRevision): string {
+  return taskCentricDigest(
+    plan.proposal.work_items.work_items.map(
+      ({ validation, acceptance_criteria, objective, ...item }) => {
+        void validation;
+        void acceptance_criteria;
+        void objective;
+        return item;
+      },
+    ),
+  );
+}
