+      status: "denied",
+    });
+    expect(gitMutationSession.trace().at(-1)).toMatchObject({
+      capability: "git.head",
+      status: "denied",
+    });
+    expect(gitHeadSession.trace().at(-1)).toMatchObject({
+      capability: "git.mutate",
+      status: "denied",
+    });
+  });
