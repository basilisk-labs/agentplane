+type StreamingProcess = Promise<{ exitCode: number }> & {
+  stdout?: Readable | null;
+  stderr?: Readable | null;
+};
+
+function combineOutput(stdout: string, stderr: string): string {
+  if (!stdout) return stderr;
+  if (!stderr) return stdout;
