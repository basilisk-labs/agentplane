+  schema_version: 1;
+  kind: "runner_phase_tool_response";
+  status: "ok" | "denied";
+  code: RunnerPhaseToolResponseCode;
+  tool: string;
+  run_id: string | null;
+  work_order_id: string | null;
+  data: unknown;
+  audit: {
+    path: string;
+    digest: string;
+  } | null;
+};
