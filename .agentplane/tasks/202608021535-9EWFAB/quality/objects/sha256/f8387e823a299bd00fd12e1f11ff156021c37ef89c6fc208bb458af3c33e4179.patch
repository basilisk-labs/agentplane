+    ] as const;
+    const artifacts = await Promise.all(
+      definitions.map(([logicalName, kind, extension, mediaType, contents]) =>
+        putEvaluatorEvidenceObject({
+          gitRoot: root,
+          taskQualityRoot: qualityRoot,
