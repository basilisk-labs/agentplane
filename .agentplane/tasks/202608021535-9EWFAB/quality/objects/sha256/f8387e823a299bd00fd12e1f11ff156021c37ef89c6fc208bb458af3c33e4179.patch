+            extension: ".patch",
+            mediaType: "text/x-diff",
+            contents: "must remain inside the repository\n",
+          }),
+        ).rejects.toThrow(/symbolic link/u);
+        expect(await readdir(outsideRoot)).toEqual([]);
+      } finally {
+        await rm(outsideRoot, { recursive: true, force: true });
+      }
+    });
+  }
