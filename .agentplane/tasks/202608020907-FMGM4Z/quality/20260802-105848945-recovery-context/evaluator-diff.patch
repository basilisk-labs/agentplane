+  await expect(
+    applyForeignTaskReadmeReplicaRepair({
+      ctx,
+      activeTaskId: ACTIVE_TASK_ID,
+      baseBranch: "main",
+    }),
+  ).resolves.toMatchObject({ state: "skipped" });
+  await expect(readFile(fixture.replicaPath, "utf8")).resolves.toContain('status: "TODO"');
+}
