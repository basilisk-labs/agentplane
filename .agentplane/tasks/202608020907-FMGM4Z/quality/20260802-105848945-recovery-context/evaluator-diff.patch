+    const ctx = await targetContext(fixture.baseRoot, fixture.targetWorktree);
+
+    expect(path.resolve(ctx.resolvedProject.gitRoot)).toBe(path.resolve(fixture.targetWorktree));
+    await expect(
+      inspectForeignTaskReadmeReplicaRepair({
