+
+function makeTask(index: number): TaskSummary {
+  return {
+    id: `2026072601${String(index).padStart(2, "0")}-ACTIVE`,
+    title: `Active task ${index}`,
+    description: "Bound route fan-out",
+    status: "TODO",
+    priority: "med",
+    owner: "CODER",
+    depends_on: [],
