+    expect(
+      classifyForeignTaskReadmeReplicaText({
+        replicaText: doing,
+        sourceText: doing,
+      }),
+    ).toBe("byte_identical");
+    expect(
+      classifyForeignTaskReadmeReplicaText({
+        replicaText: todo,
+        sourceText: doing,
+      }),
+    ).toBeNull();
+    expect(
+      classifyForeignTaskReadmeReplicaText({
+        replicaText: taskReadme({
+          taskId: FOREIGN_TASK_ID,
+          status: "TODO",
