+          quality_review: { ...task.quality_review!, evaluated_sha: "f".repeat(40) },
+        } as TaskData),
+      ),
+    ).toMatchObject({
+      kind: "terminal",
+      outcome: { type: "repair_required" },
+    });
+    const mismatched = {
+      ...canonical,
+      aggregate: {
+        ...canonical.aggregate,
+        work_items: {
+          W1: {
+            state: "COMPLETED",
+            validation: {
+              status: "PASSED",
+              identity: { hosted_head_evidence_digest: `sha256:${"0".repeat(64)}` },
+            },
