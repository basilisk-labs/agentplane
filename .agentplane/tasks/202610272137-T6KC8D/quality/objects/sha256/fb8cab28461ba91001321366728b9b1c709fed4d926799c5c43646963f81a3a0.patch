+      journal,
+      operation_key: entry.operation_key,
+    });
+    const completed = completeSupervisorExecutionEpisode({
+      journal: reopened,
+      operation_key: entry.operation_key,
+      result: { kind: "adopted_provider_effect_reconciled", operation_id: operation.id },
