+        },
+      },
+    };
+    expect(
+      reduceRouteState(
+        state({
+          ...task,
+          extensions: {
+            ...task.extensions,
+            task_kernel: { ...mismatched, digest: taskKernel.kernelDigest(mismatched) },
+          },
+        } as TaskData),
+      ),
+    ).toMatchObject({
+      kind: "terminal",
+      outcome: { type: "repair_required" },
+    });
+  });
+
+  it("routes a provider-proven merge to native task closure", () => {
+    const mergeCommit = "f".repeat(40);
