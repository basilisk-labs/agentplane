+    const merged: PrFlowStatusReport = {
+      ...prFlow,
+      pr: { ...prFlow.pr, state: "MERGED", mergeCommit },
+      providerObservation: {
+        state: "found",
+        pr: {
+          ...prFlow.providerObservation.pr,
+          status: "MERGED",
+          mergeCommit,
+          mergedAt,
+        },
+      },
+    };
+    expect(reduceRouteState(state(task, merged))).toMatchObject({
+      kind: "cli_operation",
+      operation: {
+        id: "task.adopted.finish",
