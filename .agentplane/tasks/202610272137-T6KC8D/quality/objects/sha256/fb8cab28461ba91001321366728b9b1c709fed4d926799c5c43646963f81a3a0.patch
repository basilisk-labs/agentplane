+        }))
+      ) {
+        throw new Error("Adopted merge recovery lacks exact pre-merge base proof");
+      }
+      await adoptionStore.recordMerged(
+        opts.task_id,
+        params.headSha,
+        observed.pr.mergeCommit,
+        observed.pr.mergedAt,
+      );
+    }
