+} from "../shared/side-effect-authority.js";
+import { adoptExistingPr, type ExistingPrAdoptionStore } from "./adoption-route.js";
+import type { TaskData } from "../../backends/task-backend.js";
+import type { AdoptedPrIdentity } from "./adoption-identity.js";
+import type { ObservedChangeRequest } from "./internal/change-request-model.js";
+
+const taskId = "T-1";
+const requestDigest = `sha256:${"f".repeat(64)}`;
+const identity = {
+  provider: "github" as const,
+  hostname: "github.com",
+  remote: "origin",
+  sourceProject: "example/project",
+  targetProject: "example/project",
+  sourceUrl: "https://github.com/example/project.git",
+  targetUrl: "https://github.com/example/project.git",
+};
+const claim = {
+  taskId,
+  identity,
+  prNumber: 42,
+  headRef: "automation/upgrade",
+  baseRef: "main",
+  headSha: "a".repeat(40),
+  baseSha: "b".repeat(40),
+};
+const observed: ObservedChangeRequest = {
+  provider: "github",
+  identity,
+  prNumber: claim.prNumber,
+  prUrl: "https://github.com/example/project/pull/42",
+  status: "OPEN",
+  mergedAt: null,
+  mergeCommit: null,
+  base: claim.baseRef,
+  baseSha: claim.baseSha,
+  headRef: claim.headRef,
+  headSha: claim.headSha,
+  mergeability: { state: "not_conflicting", mergeable: true, providerState: "clean" },
+};
+const fingerprint = buildStateFingerprint({
+  task_id: taskId,
+  task_revision: 1,
+  git_head: "c".repeat(40),
+  worktree: "/repo/worktree",
+  components: {
+    task: { state: "present", source: "fixture", value: { taskId } },
+    git: { state: "present", source: "fixture", value: { head: "c".repeat(40) } },
+    backend_projection: { state: "present", source: "fixture", value: {} },
+    policy: { state: "present", source: "fixture", value: {} },
+    plan: { state: "present", source: "fixture", value: {} },
+    capability: { state: "present", source: "fixture", value: {} },
+    knowledge: { state: "present", source: "fixture", value: {} },
+    provider: { state: "present", source: "fixture", value: observed },
+    authority: { state: "present", source: "fixture", value: {} },
+  },
+});
+const operation = {
+  id: "pr.existing.adopt" as const,
+  type: "pr_adopt" as const,
+  params: { taskId, requestDigest },
+};
+const grant = createSideEffectAuthorityRecord({
+  actor: "USER",
+  operation,
+  fingerprint,
+  issuedAt: "2026-10-27T10:00:00.000Z",
+  expiresAt: "2099-10-27T10:15:00.000Z",
+});
+const task = {
+  plan_approval: { state: "approved" },
+  execution_contract: {
+    selected_mode: "branch_pr",
+    authority: {
+      allowed_external_effects: ["network_read", "external_write"],
+      forbidden_external_effects: [],
+    },
+  },
+  extensions: withSideEffectAuthorityState(
+    { extensions: { task_kernel: { kind: "canonical_task" } } },
+    { schemaVersion: 1, grants: [grant], audit: [] },
+  ),
+} as TaskData;
+
+function fixture() {
+  let retained: AdoptedPrIdentity | null = null;
+  const observe = vi.fn((): Promise<ObservedChangeRequest> => Promise.resolve(observed));
+  const createIfUnbound = vi.fn((value: AdoptedPrIdentity) => {
+    if (retained) throw new Error("concurrent duplicate binding");
+    retained = value;
+    return Promise.resolve();
+  });
+  const store: ExistingPrAdoptionStore = {
+    readTask: () => Promise.resolve(retained),
+    findBinding: () => Promise.resolve(retained),
+    createIfUnbound,
+  };
+  const input = {
+    claim,
+    task,
+    fingerprint,
+    grant,
+    requestDigest,
+    observedAt: "2026-10-27T10:01:00.000Z",
+    observe,
+    store,
+  };
+  return { input, observe, createIfUnbound };
+}
+
+describe("existing PR adoption route", () => {
+  it("persists one exact provider readback and accepts a bounded replay", async () => {
+    const f = fixture();
+    const first = await adoptExistingPr(f.input);
+    expect(first.state).toBe("adopted");
+    expect(f.observe).toHaveBeenCalledTimes(2);
+    f.observe.mockResolvedValue({
+      ...observed,
+      mergeability: { state: "pending", mergeable: null, providerState: "pending" },
+    });
+    const replay = await adoptExistingPr({
+      ...f.input,
+      observedAt: "2026-10-27T10:02:00.000Z",
+      fingerprint: { ...fingerprint, digest: `sha256:${"e".repeat(64)}` },
+    });
+    expect(replay.state).toBe("already_adopted");
+    expect(f.createIfUnbound).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not write when the provider head changed during readback", async () => {
+    const f = fixture();
+    f.observe.mockResolvedValueOnce(observed).mockResolvedValueOnce({
+      ...observed,
+      headSha: "d".repeat(40),
+    });
+    await expect(adoptExistingPr(f.input)).rejects.toThrow("changed");
+    expect(f.createIfUnbound).not.toHaveBeenCalled();
+  });
+
+  it("rejects a mismatched grant before reading or writing the provider", async () => {
+    const f = fixture();
+    await expect(
+      adoptExistingPr({ ...f.input, requestDigest: `sha256:${"e".repeat(64)}` }),
+    ).rejects.toThrow("matching, separate USER grant");
+    expect(f.observe).not.toHaveBeenCalled();
+    expect(f.createIfUnbound).not.toHaveBeenCalled();
+  });
+
+  it("rejects a supplied grant absent from durable task authority", async () => {
+    const f = fixture();
+    await expect(
+      adoptExistingPr({
+        ...f.input,
+        task: { ...task, extensions: { task_kernel: { kind: "canonical_task" } } } as TaskData,
+      }),
+    ).rejects.toThrow("missing from durable authority state");
+    expect(f.observe).not.toHaveBeenCalled();
+    expect(f.createIfUnbound).not.toHaveBeenCalled();
+  });
+
+  it("rejects a task that forbids external writes even with a matching USER grant", async () => {
+    const f = fixture();
+    const denied = {
+      ...task,
+      execution_contract: {
+        ...task.execution_contract!,
+        authority: {
+          ...task.execution_contract!.authority,
+          allowed_external_effects: ["network_read"],
+          forbidden_external_effects: ["external_write"],
+        },
+      },
+    } as TaskData;
+    await expect(adoptExistingPr({ ...f.input, task: denied })).rejects.toThrow(
+      "native execution contract",
+    );
+    expect(f.observe).not.toHaveBeenCalled();
+    expect(f.createIfUnbound).not.toHaveBeenCalled();
+  });
+
+  it("rejects another task's binding before a write", async () => {
+    const f = fixture();
+    const first = await adoptExistingPr(f.input);
+    const prior = first.receipt;
+    const fresh = fixture();
+    fresh.input.store.readTask = () => Promise.resolve(null);
+    fresh.input.store.findBinding = () => Promise.resolve({ ...prior, task_id: "T-OTHER" });
+    await expect(adoptExistingPr(fresh.input)).rejects.toThrow("already bound");
+    expect(fresh.createIfUnbound).not.toHaveBeenCalled();
+  });
+
+  it("does not overwrite a retained receipt after an incomplete replay", async () => {
+    const f = fixture();
+    const first = await adoptExistingPr(f.input);
+    const prior = first.receipt;
+    f.input.store.readTask = () =>
+      Promise.resolve({
+        ...prior,
+        readback_digest: `sha256:${"0".repeat(64)}`,
+      });
+    await expect(adoptExistingPr(f.input)).rejects.toThrow("different or partially replayed");
+    expect(f.createIfUnbound).toHaveBeenCalledTimes(1);
+    f.input.store.readTask = () => Promise.resolve({ ...prior, head_sha: "d".repeat(40) });
+    await expect(adoptExistingPr(f.input)).rejects.toThrow("different or partially replayed");
+  });
+
+  it("rejects a replay when the retained PR binding belongs to another task", async () => {
+    const f = fixture();
+    const first = await adoptExistingPr(f.input);
+    f.input.store.findBinding = () => Promise.resolve({ task_id: "T-OTHER" });
+    await expect(adoptExistingPr(f.input)).rejects.toThrow("no unique matching task binding");
+    expect(f.createIfUnbound).toHaveBeenCalledTimes(1);
+    expect(first.state).toBe("adopted");
+  });
+
+  it("propagates a concurrent uniqueness rejection without a second write", async () => {
+    const f = fixture();
+    f.input.store.createIfUnbound = () => {
+      throw new Error("concurrent duplicate binding");
+    };
+    await expect(adoptExistingPr(f.input)).rejects.toThrow("concurrent duplicate binding");
+    expect(f.createIfUnbound).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/agentplane/src/commands/pr/adoption-route.ts b/packages/agentplane/src/commands/pr/adoption-route.ts
new file mode 100644
index 000000000..b76acbdbb
--- /dev/null
+++ b/packages/agentplane/src/commands/pr/adoption-route.ts
@@ -0,0 +1,110 @@
+import type { StateFingerprint } from "@agentplaneorg/core/schemas";
+import { canonicalizeJson } from "@agentplaneorg/core/tasks";
+
+import {
+  evaluateWorkflowOperationAuthority,
+  readSideEffectAuthorityState,
+  workflowOperationAuthorityDigest,
+} from "../shared/side-effect-authority.js";
+import type { SideEffectAuthorityRecord } from "../shared/side-effect-authority-policy.js";
+import type { WorkflowOperation } from "../shared/workflow-step.js";
+import {
+  bindObservedExistingPr,
+  sameAdoption,
+  type AdoptedPrIdentity,
+  type ExistingPrAdoptionClaim,
+} from "./adoption-identity.js";
+import type { ObservedChangeRequest } from "./internal/change-request-model.js";
+import type { TaskData } from "../../backends/task-backend.js";
+import { assertAdoptionTaskAuthority } from "./adoption-task-authority.js";
+
+export type ExistingPrAdoptionStore = {
+  /** Read a retained receipt for this task. Malformed receipts must throw. */
+  readTask(taskId: string): Promise<AdoptedPrIdentity | null>;
+  /** Read any task already bound to the exact provider PR identity. */
+  findBinding(identity: AdoptedPrIdentity): Promise<{ task_id: string } | null>;
+  /** Atomic first-write. A concurrent duplicate task or PR claim must reject. */
+  createIfUnbound(identity: AdoptedPrIdentity): Promise<void>;
+};
+
+function sameAdoptionTarget(left: AdoptedPrIdentity, right: AdoptedPrIdentity): boolean {
+  const { observed_at: _leftTime, ...leftTarget } = left;
+  const { observed_at: _rightTime, ...rightTarget } = right;
+  return (
+    JSON.stringify(canonicalizeJson(leftTarget)) === JSON.stringify(canonicalizeJson(rightTarget))
+  );
+}
+
+/** The operator route must pass a grant from the durable authority store. */
+export async function adoptExistingPr(opts: {
+  claim: Omit<ExistingPrAdoptionClaim, "authorityDigest">;
+  task: TaskData;
+  fingerprint: StateFingerprint;
+  grant: SideEffectAuthorityRecord;
+  requestDigest: string;
+  observedAt: string;
+  observe: () => Promise<ObservedChangeRequest>;
+  store: ExistingPrAdoptionStore;
+}): Promise<{ state: "adopted" | "already_adopted"; receipt: AdoptedPrIdentity }> {
+  assertAdoptionTaskAuthority(opts.task);
+  const operation = {
+    id: "pr.existing.adopt",
+    type: "pr_adopt",
+    params: { taskId: opts.claim.taskId, requestDigest: opts.requestDigest },
+  } as const satisfies Pick<WorkflowOperation, "id" | "type" | "params">;
+  if (
+    opts.grant.actor !== "USER" ||
+    opts.grant.operationId !== operation.id ||
+    opts.grant.operationDigest !== workflowOperationAuthorityDigest(operation)
+  ) {
+    throw new Error("Existing PR adoption requires a matching, separate USER grant");
+  }
+  const retainedAuthority = readSideEffectAuthorityState(opts.task);
+  if (!retainedAuthority?.grants.some((entry) => entry.digest === opts.grant.digest)) {
+    throw new Error("Existing PR adoption grant is missing from durable authority state");
+  }
+
+  const observed = await opts.observe();
+  const proposed = bindObservedExistingPr(
+    { ...opts.claim, authorityDigest: opts.grant.digest },
+    observed,
+    opts.observedAt,
+  );
+  const retained = await opts.store.readTask(opts.claim.taskId);
+  if (retained) {
+    if (!sameAdoptionTarget(retained, proposed)) {
+      throw new Error("Task already has a different or partially replayed PR adoption");
+    }
+    const binding = await opts.store.findBinding(retained);
+    if (binding?.task_id !== opts.claim.taskId) {
+      throw new Error("Retained PR adoption has no unique matching task binding");
+    }
+    return { state: "already_adopted", receipt: retained };
+  }
+  const decision = evaluateWorkflowOperationAuthority({
+    task: opts.task,
+    operation,
+    fingerprint: opts.fingerprint,
+  });
+  if (decision.state !== "allowed" || decision.authority?.digest !== opts.grant.digest) {
+    throw new Error("Existing PR adoption grant is stale or does not match the current state");
+  }
+  const other = await opts.store.findBinding(proposed);
+  if (other) {
+    throw new Error("Hosted PR is already bound to another task");
+  }
+
+  // A separate provider readback closes the window between preparation and
+  // durable write. The store must also enforce uniqueness under one lock.
+  const finalReceipt = bindObservedExistingPr(
+    { ...opts.claim, authorityDigest: opts.grant.digest },
+    await opts.observe(),
+    opts.observedAt,
+  );
+  await opts.store.createIfUnbound(finalReceipt);
+  const written = await opts.store.readTask(opts.claim.taskId);
+  if (!written || !sameAdoption(written, finalReceipt)) {
+    throw new Error("Existing PR adoption write has no matching durable readback");
+  }
+  return { state: "adopted", receipt: written };
+}
diff --git a/packages/agentplane/src/commands/pr/adoption-store.test.ts b/packages/agentplane/src/commands/pr/adoption-store.test.ts
new file mode 100644
index 000000000..c3fe865a9
--- /dev/null
+++ b/packages/agentplane/src/commands/pr/adoption-store.test.ts
@@ -0,0 +1,131 @@
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+
+import { afterEach, describe, expect, it } from "vitest";
+
+import { assertTaskOwnedPrSync, createExistingPrAdoptionStore } from "./adoption-store.js";
+import type { AdoptedPrIdentity } from "./adoption-identity.js";
+
+const roots: string[] = [];
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+const receipt: AdoptedPrIdentity = {
+  schema_version: 1,
+  task_id: "T-1",
+  provider: "github",
+  hostname: "github.com",
+  remote: "origin",
+  source_project: "example/repo",
+  target_project: "example/repo",
+  pr_number: 42,
+  head_ref: "upgrade/dependencies",
+  base_ref: "main",
+  head_sha: "a".repeat(40),
+  base_sha: "b".repeat(40),
+  observed_at: "2026-10-27T10:00:00.000Z",
+  readback_digest: `sha256:${"c".repeat(64)}`,
+  authority_digest: `sha256:${"d".repeat(64)}`,
+};
+
+describe("existing PR adoption metadata store", () => {
+  it("keeps the original adoption proof and rejects another task's claim to the hosted PR", async () => {
+    const root = await mkdtemp(path.join(os.tmpdir(), "agentplane-pr-adoption-"));
+    roots.push(root);
+    const store = createExistingPrAdoptionStore({ gitRoot: root, workflowDir: "tasks" });
+    await expect(store.createIfUnbound(receipt)).resolves.toBeUndefined();
+    expect(await store.readTask("T-1")).toEqual(receipt);
+    expect(await store.findBinding({ ...receipt, head_sha: "e".repeat(40) })).toEqual({
+      task_id: "T-1",
+    });
+    await expect(store.createIfUnbound({ ...receipt, task_id: "T-2" })).rejects.toThrow(
+      "already has a task or provider binding",
+    );
+    await expect(store.createIfUnbound({ ...receipt, head_sha: "e".repeat(40) })).rejects.toThrow(
+      "already has a task or provider binding",
+    );
+    const meta = JSON.parse(await readFile(path.join(root, "tasks/T-1/pr/meta.json"), "utf8")) as {
+      adoption: AdoptedPrIdentity;
+      head_sha?: string;
+    };
+    expect(meta.adoption).toEqual(receipt);
+    expect(meta.head_sha).toBeUndefined();
+    expect(() => assertTaskOwnedPrSync(meta)).toThrow("task-owned PR sync is forbidden");
+  });
+
+  it("does not create a receipt when task metadata is malformed", async () => {
+    const root = await mkdtemp(path.join(os.tmpdir(), "agentplane-pr-adoption-"));
+    roots.push(root);
+    const store = createExistingPrAdoptionStore({ gitRoot: root, workflowDir: "tasks" });
+    await expect(store.createIfUnbound(receipt)).resolves.toBeUndefined();
+    await expect(store.readTask("../T-1")).rejects.toThrow("task ID is invalid");
+    await expect(store.createIfUnbound({ ...receipt, task_id: "../T-2" })).rejects.toThrow(
+      "task ID is invalid",
+    );
+  });
+
+  it("ignores ordinary metadata on read while preserving strict adoption and creation checks", async () => {
+    const root = await mkdtemp(path.join(os.tmpdir(), "agentplane-pr-adoption-"));
+    roots.push(root);
+    const metaPath = path.join(root, "tasks/T-1/pr/meta.json");
+    await mkdir(path.dirname(metaPath), { recursive: true });
+    await writeFile(metaPath, "{}\n");
+    const store = createExistingPrAdoptionStore({ gitRoot: root, workflowDir: "tasks" });
+    expect(await store.readTask("T-1")).toBeNull();
+    expect(await store.findBinding(receipt)).toBeNull();
+    await expect(store.createIfUnbound(receipt)).rejects.toThrow("schema validation failed");
+    await writeFile(metaPath, `${JSON.stringify({ adoption: receipt })}\n`);
+    await expect(store.readTask("T-1")).rejects.toThrow("schema validation failed");
+    await expect(store.findBinding(receipt)).rejects.toThrow("schema validation failed");
+  });
+
+  it("records a provider-proven merge without changing the immutable adoption proof", async () => {
+    const root = await mkdtemp(path.join(os.tmpdir(), "agentplane-pr-adoption-"));
+    roots.push(root);
+    const store = createExistingPrAdoptionStore({ gitRoot: root, workflowDir: "tasks" });
+    await store.createIfUnbound(receipt);
+    const commit = "e".repeat(40);
+    const mergedAt = "2026-10-27T11:00:00.000Z";
+    await expect(store.recordMerged("T-1", "f".repeat(40), commit, mergedAt)).rejects.toThrow(
+      "exact head",
+    );
+    await store.recordMerged("T-1", receipt.head_sha, commit, mergedAt);
+    await store.recordMerged("T-1", receipt.head_sha, commit, mergedAt);
+    expect(await store.readTask("T-1")).toEqual(receipt);
+    expect(await store.readMerged("T-1")).toEqual({
+      headSha: receipt.head_sha,
+      mergeCommit: commit,
+      mergedAt,
+    });
+    await expect(
+      store.recordMerged("T-1", receipt.head_sha, "f".repeat(40), mergedAt),
+    ).rejects.toThrow("different evidence");
+    await expect(
+      store.recordMerged("T-1", receipt.head_sha, commit, "2026-10-27T11:00:01.000Z"),
+    ).rejects.toThrow("different evidence");
+  });
+
+  it("moves only the mutable current head after a proven update and binds merge to that head", async () => {
+    const root = await mkdtemp(path.join(os.tmpdir(), "agentplane-pr-adoption-"));
+    roots.push(root);
+    const store = createExistingPrAdoptionStore({ gitRoot: root, workflowDir: "tasks" });
+    await store.createIfUnbound(receipt);
+    const updated = "e".repeat(40);
+    await expect(store.recordUpdatedHead("T-1", "f".repeat(40), updated)).rejects.toThrow(
+      "retained current head",
+    );
+    await store.recordUpdatedHead("T-1", receipt.head_sha, updated);
+    await store.recordUpdatedHead("T-1", receipt.head_sha, updated);
+    expect(await store.readTask("T-1")).toEqual(receipt);
+    const updatedMeta = await store.readMetadata("T-1");
+    expect(updatedMeta?.head_sha).toBe(updated);
+    await expect(
+      store.recordMerged("T-1", receipt.head_sha, "f".repeat(40), "2026-10-27T11:00:00Z"),
+    ).rejects.toThrow("exact head");
+    await store.recordMerged("T-1", updated, "f".repeat(40), "2026-10-27T11:00:00Z");
+    const mergedMeta = await store.readMetadata("T-1");
+    expect(mergedMeta?.adoption).toEqual(receipt);
+  });
+});
diff --git a/packages/agentplane/src/commands/pr/adoption-store.ts b/packages/agentplane/src/commands/pr/adoption-store.ts
new file mode 100644
index 000000000..dbb48f4e7
--- /dev/null
+++ b/packages/agentplane/src/commands/pr/adoption-store.ts
@@ -0,0 +1,258 @@
+import { mkdir, readdir, rm } from "node:fs/promises";
+import path from "node:path";
+
+import { validateTaskPrMeta } from "@agentplaneorg/core/schemas";
+import { listWorktrees } from "@agentplaneorg/core/git";
+
+import { readContainedStableTextNoFollow } from "../../shared/contained-stable-file.js";
+import { writeTextIfChanged } from "../../shared/write-if-changed.js";
+import type { AdoptedPrIdentity } from "./adoption-identity.js";
+import type { ExistingPrAdoptionStore } from "./adoption-route.js";
+
+type AdoptionMeta = ReturnType<typeof validateTaskPrMeta> & {
+  adoption?: AdoptedPrIdentity;
+};
+
+function validateMeta(taskId: string, raw: unknown): AdoptionMeta {
+  const meta = validateTaskPrMeta(raw) as AdoptionMeta;
+  if (meta.task_id !== taskId) throw new Error("Existing PR metadata task ID changed");
+  return meta;
+}
+
+/** Adoption evidence belongs to the primary control checkout, never the hosted or task worktree. */
+export async function resolveAdoptionControlRoot(gitRoot: string): Promise<string> {
+  const worktrees = await listWorktrees(gitRoot);
+  const primary = worktrees[0]?.path;
+  if (!primary) throw new Error("Existing PR adoption has no registered primary checkout");
+  return path.resolve(primary);
+}
+
+/** An adopted provider branch is never the task-owned artifact publication branch. */
+export function assertTaskOwnedPrSync(meta: AdoptionMeta | null): void {
+  if (meta?.adoption) {
+    throw new Error(
+      "Adopted PR requires its dedicated readback/update route; task-owned PR sync is forbidden",
+    );
+  }
+}
+
+function sameHostedPr(left: AdoptedPrIdentity, right: AdoptedPrIdentity): boolean {
+  return (
+    left.provider === right.provider &&
+    left.hostname === right.hostname &&
+    left.source_project === right.source_project &&
+    left.target_project === right.target_project &&
+    left.pr_number === right.pr_number
+  );
+}
+
+/** The task PR metadata is the durable receipt; no live head overwrites adoption evidence. */
+export function createExistingPrAdoptionStore(opts: {
+  gitRoot: string;
+  workflowDir: string;
+}): ExistingPrAdoptionStore & {
+  readMetadata: (taskId: string) => Promise<AdoptionMeta | null>;
+  recordUpdatedHead: (
+    taskId: string,
+    expectedHeadSha: string,
+    updatedHeadSha: string,
+  ) => Promise<void>;
+  recordMerged: (
+    taskId: string,
+    headSha: string,
+    mergeCommit: string,
+    mergedAt: string,
+  ) => Promise<void>;
+  readMerged: (
+    taskId: string,
+  ) => Promise<{ headSha: string; mergeCommit: string; mergedAt: string } | null>;
+} {
+  const tasksRoot = path.resolve(opts.gitRoot, opts.workflowDir);
+  const metaPath = (taskId: string) => {
+    if (!/^[A-Za-z0-9][A-Za-z0-9_-]*$/u.test(taskId)) {
+      throw new Error("Existing PR adoption task ID is invalid");
+    }
+    return path.join(tasksRoot, taskId, "pr", "meta.json");
+  };
+  const readRawMeta = async (taskId: string): Promise<unknown> => {
+    let raw: string;
+    try {
+      raw = await readContainedStableTextNoFollow({
+        repository_root: opts.gitRoot,
+        file_path: metaPath(taskId),
+        label: "existing PR adoption metadata",
+        max_bytes: 1024 * 1024,
+      });
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+      throw error;
+    }
+    return JSON.parse(raw) as unknown;
+  };
+  const readMeta = async (taskId: string): Promise<AdoptionMeta | null> => {
+    const raw = await readRawMeta(taskId);
+    return raw === undefined ? null : validateMeta(taskId, raw);
+  };
+  const readAdoptionMeta = async (taskId: string): Promise<AdoptionMeta | null> => {
+    const raw = await readRawMeta(taskId);
+    if (raw === undefined || raw === null || typeof raw !== "object" || !("adoption" in raw))
+      return null;
+    return validateMeta(taskId, raw);
+  };
+  const findBinding = async (identity: AdoptedPrIdentity) => {
+    for (const entry of await readdir(tasksRoot, { withFileTypes: true })) {
+      if (!entry.isDirectory() || !/^[A-Za-z0-9][A-Za-z0-9_-]*$/u.test(entry.name)) continue;
+      const meta = await readAdoptionMeta(entry.name);
+      const retained = meta?.adoption;
+      if (retained && sameHostedPr(retained, identity)) return { task_id: entry.name };
+    }
+    return null;
+  };
+  return {
+    readMetadata: readMeta,
+    recordUpdatedHead: async (taskId, expectedHeadSha, updatedHeadSha) => {
+      if (
+        !/^[a-f0-9]{40,64}$/u.test(expectedHeadSha) ||
+        !/^[a-f0-9]{40,64}$/u.test(updatedHeadSha) ||
+        expectedHeadSha === updatedHeadSha
+      )
+        throw new Error("Adopted PR updated head receipt is invalid");
+      const lockPath = path.join(tasksRoot, ".existing-pr-adoption.lock");
+      await mkdir(lockPath);
+      try {
+        const meta = await readMeta(taskId);
+        if (meta?.adoption?.task_id !== taskId || meta.status !== "OPEN") {
+          throw new Error("Adopted PR update has no open immutable task binding");
+        }
+        if (meta.head_sha === updatedHeadSha) return;
+        if ((meta.head_sha ?? meta.adoption.head_sha) !== expectedHeadSha) {
+          throw new Error("Adopted PR update changed the retained current head");
+        }
+        await writeTextIfChanged(
+          metaPath(taskId),
+          `${JSON.stringify(
+            {
+              ...meta,
+              head_sha: updatedHeadSha,
+              last_verified_sha: null,
+              last_verified_at: null,
+              verify: undefined,
+              updated_at: new Date().toISOString(),
+            },
+            null,
+            2,
+          )}\n`,
+          { containedRoot: opts.gitRoot, label: "adopted PR updated head metadata" },
+        );
+      } finally {
+        await rm(lockPath, { recursive: true, force: true });
+      }
+    },
+    readTask: async (taskId) => {
+      const meta = await readAdoptionMeta(taskId);
+      return meta?.adoption ?? null;
+    },
+    readMerged: async (taskId) => {
+      const meta = await readMeta(taskId);
+      if (!meta?.adoption || meta.status !== "MERGED" || !meta.merge_commit || !meta.merged_at)
+        return null;
+      return {
+        headSha: meta.head_sha ?? meta.adoption.head_sha,
+        mergeCommit: meta.merge_commit,
+        mergedAt: meta.merged_at,
+      };
+    },
+    findBinding,
+    createIfUnbound: async (identity) => {
+      // A single task-root lock serializes duplicate claims across task IDs.
+      const lockPath = path.join(tasksRoot, ".existing-pr-adoption.lock");
+      await mkdir(tasksRoot, { recursive: true });
+      await mkdir(lockPath);
+      try {
+        const previous = await readMeta(identity.task_id);
+        if (previous?.adoption || (await findBinding(identity))) {
+          throw new Error("Existing PR adoption already has a task or provider binding");
+        }
+        if (
+          previous &&
+          (previous.pr_number !== undefined ||
+            previous.provider !== undefined ||
+            previous.branch !== undefined ||
+            previous.base !== undefined)
+        ) {
+          throw new Error("Task already has PR metadata; adoption cannot replace it");
+        }
+        const meta: AdoptionMeta = {
+          ...(previous ?? {
+            schema_version: 1,
+            task_id: identity.task_id,
+            created_at: identity.observed_at,
+            updated_at: identity.observed_at,
+          }),
+          branch: identity.head_ref,
+          base: identity.base_ref,
+          pr_number: identity.pr_number,
+          provider: {
+            schema_version: 1,
+            kind: identity.provider,
+            hostname: identity.hostname,
+            remote: identity.remote,
+            source_project: identity.source_project,
+            target_project: identity.target_project,
+          },
+          status: "OPEN",
+          adoption: identity,
+        };
+        const target = metaPath(identity.task_id);
+        await mkdir(path.dirname(target), { recursive: true });
+        await writeTextIfChanged(target, `${JSON.stringify(meta, null, 2)}\n`, {
+          containedRoot: opts.gitRoot,
+          label: "existing PR adoption metadata",
+        });
+      } finally {
+        await rm(lockPath, { recursive: true, force: true });
+      }
+    },
+    recordMerged: async (taskId, headSha, mergeCommit, mergedAt) => {
+      if (
+        !/^[a-f0-9]{40,64}$/u.test(headSha) ||
+        !/^[a-f0-9]{40,64}$/u.test(mergeCommit) ||
+        !Number.isFinite(Date.parse(mergedAt))
+      ) {
+        throw new Error("Adopted PR merge receipt is invalid");
+      }
+      const lockPath = path.join(tasksRoot, ".existing-pr-adoption.lock");
+      await mkdir(lockPath);
+      try {
+        const meta = await readMeta(taskId);
+        if (
+          meta?.adoption?.task_id !== taskId ||
+          (meta.head_sha ?? meta.adoption.head_sha) !== headSha
+        ) {
+          throw new Error("Adopted PR merge no longer matches the retained task and exact head");
+        }
+        if (
+          meta.status === "MERGED" &&
+          meta.merge_commit === mergeCommit &&
+          meta.merged_at === mergedAt
+        )
+          return;
+        if (meta.status !== "OPEN")
+          throw new Error("Adopted PR merge metadata is already closed with different evidence");
+        const next: AdoptionMeta = {
+          ...meta,
+          status: "MERGED",
+          merged_at: mergedAt,
+          merge_commit: mergeCommit,
+          updated_at: mergedAt,
+        };
+        await writeTextIfChanged(metaPath(taskId), `${JSON.stringify(next, null, 2)}\n`, {
+          containedRoot: opts.gitRoot,
+          label: "adopted PR merge metadata",
+        });
+      } finally {
+        await rm(lockPath, { recursive: true, force: true });
+      }
+    },
+  };
+}
