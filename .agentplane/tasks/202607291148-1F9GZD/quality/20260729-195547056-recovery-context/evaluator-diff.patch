+                },
+                token_usage_by_role: {
+                  CODER: {
+                    input_tokens: { count: 5, mean: 100 },
+                    output_tokens: { count: 5, mean: 10 },
+                    reasoning_tokens: { count: 5, mean: 20 },
+                  },
+                },
+              },
+            ],
+          },
+          diagnostics: {
