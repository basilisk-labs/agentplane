+  worktree = path.join(root, "task");
+  await Promise.all([mkdir(base), mkdir(worktree)]);
+  mocks.findWorktreeForBranch.mockReset().mockResolvedValue(base);
+});
+
+afterEach(async () => {
+  await rm(root, { recursive: true, force: true });
+});
+
