+      build: () => ({
+        intents: setTaskFieldsIntent({
+          verification: {
+            state: "ok",
+            updated_at: "2026-01-02T00:00:00.000Z",
+            updated_by: "TESTER",
+            note: "Legacy verification",
+          },
+        }),
+      }),
+    });
