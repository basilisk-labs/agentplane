+          schema_version: 2,
+          kind: "agent_semantic_result",
+          work_order_id: workOrder.work_order_id,
+          status: "completed",
+          summary,
+          findings: [],
+          uncertainty: [],
+          ...(workOrder.role === "PLANNER"
+            ? { task_plan_proposal: recoveryPlanningProposal(workOrder, summary) }
+            : {}),
+        },
+      },
+      null,
+      2,
+    )}\n`,
+    "utf8",
+  );
