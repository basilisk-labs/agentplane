+      try {
+        await expect(run()).rejects.toThrow("another supervisor");
+      } finally {
+        await lease.release();
+      }
+    } else if (scenario === "live_queue") {
+      await withIntegrationQueueMutex(root, async () => {
+        await expect(run()).rejects.toThrow("mutex is already held");
+      });
+    } else if (successful) {
