+              parent_span_id: started.operation_key,
+              stage: workOrder.role === "EVALUATOR" ? "review" : "semantic_dispatch",
+              category: "external_wait",
+              started_ms: dispatchStartedAt,
+              ended_ms: endedAt,
+            },
+            ...(firstMutation
