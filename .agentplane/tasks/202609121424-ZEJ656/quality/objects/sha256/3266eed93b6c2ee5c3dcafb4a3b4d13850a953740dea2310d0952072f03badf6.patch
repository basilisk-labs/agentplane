+  }
+  if (!isRecord(evidence)) throw new Error(`${label} evidence must be an object.`);
+  return evidence;
+}
+
+function executeProcess(entrypoint, argv, cwd, env, label) {
+  return parseProcessEvidence(
+    spawnSync(entrypoint[0], [...entrypoint.slice(1), ...argv], {
