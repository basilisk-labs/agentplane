+      const approval = await runJson(root, [
+        "task",
+        "advance",
+        taskId,
+        "--result",
+        planningExchange.result_path,
+        "--agent-json",
+      ]);
+      expect(approval.action).toMatchObject({ kind: "approval_required" });
+      const replay = await runJson(root, [
+        "task",
+        "advance",
+        taskId,
+        "--result",
