+      const implementationExchange = executing.exchange as {
+        directory: string;
+        result_path: string;
+      };
+      const executor = AGENT_WORK_ORDER_V2_ZOD_SCHEMA.parse(
+        JSON.parse(
+          await readFile(path.join(implementationExchange.directory, "work-order.json"), "utf8"),
+        ),
