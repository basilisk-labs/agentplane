+      expect(replay.action).toMatchObject({ kind: "approval_required" });
+      await runCliSilent(["task", "plan", "approve", taskId, "--by", "USER", "--root", root]);
+      const executing = await runJson(root, ["task", "advance", taskId, "--agent-json"]);
