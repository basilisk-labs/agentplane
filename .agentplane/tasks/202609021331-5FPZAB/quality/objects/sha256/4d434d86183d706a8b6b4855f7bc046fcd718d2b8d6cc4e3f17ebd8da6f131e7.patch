+    (entry) =>
+      entry.branch !== null &&
+      parseTaskIdFromBranch(opts.ctx.config.branch.task_prefix, entry.branch) === opts.taskId,
+  );
+  if (registrations.length > 1) {
+    throw new CliError({
+      exitCode: 3,
+      code: "E_VALIDATION",
+      message:
