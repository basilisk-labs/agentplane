+        context: {
+          reason_code: "task_worktree_registration_missing",
+          task_id: opts.taskId,
+          branch: expectedBranch,
+        },
+      });
+    }
+    return null;
+  }
+
+  const registeredBranch = normalizeBranch(registration.branch!);
+  if (registeredBranch !== expectedBranch) {
