diff --git a/packages/agentplane/src/commands/task/plan-approval-guard.ts b/packages/agentplane/src/commands/task/plan-approval-guard.ts
new file mode 100644
index 000000000..167b50ed9
--- /dev/null
+++ b/packages/agentplane/src/commands/task/plan-approval-guard.ts
@@ -0,0 +1,23 @@
+import { taskCentricReplanRequiredFromExtensions } from "@agentplaneorg/core/tasks";
+import type { taskCentricAggregateFromExtensions } from "@agentplaneorg/core/tasks";
+
+import { CliError } from "../../shared/errors.js";
+
+export function assertCanonicalPlanCanBeApproved(
+  taskCentric: ReturnType<typeof taskCentricAggregateFromExtensions>,
+  extensions: Readonly<Record<string, unknown>> | undefined,
+): void {
+  if (taskCentric?.current_plan && taskCentricReplanRequiredFromExtensions(extensions)) {
+    throw new CliError({
+      code: "E_VALIDATION",
+      message:
+        "Canonical task plan is stale after the task document changed; complete replanning before approval.",
+    });
+  }
+  if (taskCentric?.current_plan?.approval.state === "rejected") {
+    throw new CliError({
+      code: "E_VALIDATION",
+      message: "Rejected canonical task plans cannot be approved; complete replanning first.",
+    });
+  }
+}
