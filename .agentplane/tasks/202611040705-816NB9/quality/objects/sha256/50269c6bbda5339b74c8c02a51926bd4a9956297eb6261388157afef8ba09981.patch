+      expect(mocks.acquire).not.toHaveBeenCalled();
+      expect(await lastStatus(f)).toBe("completed");
+    },
+  );
+});
diff --git a/packages/agentplane/src/commands/shared/supervisor-execution-journal.ts b/packages/agentplane/src/commands/shared/supervisor-execution-journal.ts
