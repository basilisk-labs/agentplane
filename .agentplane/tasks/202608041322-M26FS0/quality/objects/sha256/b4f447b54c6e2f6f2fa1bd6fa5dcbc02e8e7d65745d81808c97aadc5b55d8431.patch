+    evidence?.schema_version !== 1 ||
+    evidence?.kind !== "agentplane.rf04.qualification_candidate_evidence" ||
+    measurement?.schema_version !== 1 ||
+    measurement?.kind !== "agent_efficiency_candidate_measurement_v1"
+  ) {
