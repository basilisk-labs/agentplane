+    const commit = await runGhApiJson<GithubCommitRecord>(opts.gitRoot, [
+      `repos/${repo}/commits/${opts.providerHeadSha}`,
+    ]);
+    const parents = (commit.parents ?? [])
+      .map((parent) => parent.sha?.trim() ?? "")
+      .filter(Boolean);
