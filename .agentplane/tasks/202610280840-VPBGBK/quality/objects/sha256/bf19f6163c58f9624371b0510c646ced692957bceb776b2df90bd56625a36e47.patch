+  const complete = () =>
+    store.write(
+      completeSupervisorExecutionEpisode({
+        journal: started.journal,
+        operation_key: started.operation_key,
+        result: completion,
+      }),
+    );
+  return { root, git, B, H, merged, task, contract, execution, observe, complete };
