+            toolchain_digest: k.kernelDigest("node"),
+            environment_digest: k.kernelDigest("fixture"),
+          },
+          evidence_digests: [k.kernelDigest("old verification")],
+          observed_at: "2026-10-29T00:00:00.000Z",
+        },
+      },
