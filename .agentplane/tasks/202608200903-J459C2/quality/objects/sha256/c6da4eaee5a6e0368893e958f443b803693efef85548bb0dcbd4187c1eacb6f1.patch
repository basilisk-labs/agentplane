+    branch,
+    base,
+    branchHeadSha,
+    baseSha: execution.base_sha,
+    implementationCommit: branchHeadSha,
+    verifiedInputDigest: verificationAssessment.currentInputDigest,
+    workspaceId: `task:${task.id}:base:${execution.base_sha}`,
