+        gitRoot: "/repo",
+        baseBranch: "main",
+        branch: "task/T-PRIMARY/change",
+        workflowDir: ".agentplane/tasks",
+        tasksPath: ".agentplane/tasks",
+        primaryTaskId: "T-PRIMARY",
+        includedTaskIds: ["T-INCLUDED"],
+      }),
+    ).resolves.toBeUndefined();
