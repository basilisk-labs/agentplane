+      (next.nlink === 2n && !sameSnapshot(snapshot(current), snapshot(next)))
+    ) {
+      throw boundaryError(`${opts.label} changed during publication: ${opts.filePath}`);
+    }
+    current = next;
+  }
+  await opts.boundary.assertStable("after object publication finalized");
+  return current;
