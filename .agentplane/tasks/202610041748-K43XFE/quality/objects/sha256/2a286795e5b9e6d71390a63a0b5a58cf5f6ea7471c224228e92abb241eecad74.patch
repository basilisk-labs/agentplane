+      package_version: requireInstalled("@agentplaneorg/recipes/package.json").version,
+      scope:
+        "Installed public parser/parameter/V1 audit only; native retained closure and admission were qualified separately by RC16.",
+    },
+    null,
+    2,
+  ),
+);
