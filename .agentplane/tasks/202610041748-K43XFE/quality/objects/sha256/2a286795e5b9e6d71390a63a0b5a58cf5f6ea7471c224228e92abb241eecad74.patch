+);
+check(() =>
+  assert.throws(
+    () => api.resolveScenarioParameters(scenario, [...selection.bindings, selection.bindings[0]]),
+    /Duplicate parameter/,
+  ),
+);
+check(() =>
+  assert.throws(
+    () =>
+      api.resolveScenarioParameters(scenario, [
+        ...selection.bindings,
+        { name: "unknown", value: true },
+      ]),
+    /Unknown parameter/,
+  ),
+);
+check(() =>
