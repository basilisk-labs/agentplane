+            const review = await read(source, "inspection-result.json");
+            const evidence = await read(source, "validation.json");
+            if (
+              !isRecord(review) ||
+              !isRecord(review.review) ||
+              review.review.verdict !== "pass" ||
+              review.work_order_id !== id ||
