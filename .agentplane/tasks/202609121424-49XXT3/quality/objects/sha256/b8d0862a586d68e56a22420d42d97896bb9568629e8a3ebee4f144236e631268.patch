+
+describe("roadmap managed semantic output parity", () => {
+  it.each(cases)(
+    "preserves every typed field for $label",
+    async ({ workOrder, roleField, payload }) => {
+      const root = await mkdtemp(path.join(os.tmpdir(), "agentplane-roadmap-output-parity-"));
