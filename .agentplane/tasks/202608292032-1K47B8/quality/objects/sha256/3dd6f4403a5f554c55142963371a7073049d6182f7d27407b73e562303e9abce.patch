+        ...runtime,
+        state,
+        revision: runtime.revision + 1,
+        attempt: command.action === "claim" ? runtime.attempt + 1 : runtime.attempt,
+        claim_id: command.action === "claim" ? command.claim_id : runtime.claim_id,
+      };
