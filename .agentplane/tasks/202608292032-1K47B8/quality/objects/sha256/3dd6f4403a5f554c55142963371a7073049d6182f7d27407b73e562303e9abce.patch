+}
+
+function validation(implementationIdentity: Sha256Digest): ValidationRecord {
+  return {
+    status: "PASSED",
+    identity: {
+      implementation_identity: implementationIdentity,
+      check_id: "focused-tests",
+      command_digest: kernelDigest("test-command"),
