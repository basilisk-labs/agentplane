+      replay_runs: replayRuns,
+      scenarios,
+      provider_episodes: providerEpisodes,
+    },
+    verdict,
+    failure_ids: failureIds,
+    comparisons,
+    qualification_decision: verdict === "pass" ? "eligible" : "do_not_publish",
+  };
