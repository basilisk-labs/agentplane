+  taskId: string;
+  baseSha: string;
+  runner_authority: Pick<BranchTaskSupervisorOptions, "sandbox_override" | "danger_authority">;
+  drift?: "workspace" | "result" | "policy" | "projection";
+  interrupt?: boolean;
+  interruptAfterStatus?: boolean;
