+        for (const key of [
+          "state",
+          "revision",
+          "attempt",
+          "claim_id",
+          "output_manifests",
+          "validation_result",
+          "last_failure",
+        ])
+          Reflect.deleteProperty(item, key);
+      }
+    }
+    Reflect.deleteProperty(aggregate, "agentplane.task_centric_runtime");
+  }
+  return renderTaskReadme(parsed.frontmatter, parsed.body);
+}
