+    const persistedTask = await ctx.taskBackend.getTask(taskId);
+    expect(persistedTask?.runner).toMatchObject({
+      run_id: destinationRunId,
+      status: "prepared",
+    });
+    expect(persistedTask?.runner?.history).toEqual(
