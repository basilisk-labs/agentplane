+  id: "202608102112-AY0H1F",
+  title: "Completed task",
+  description: "Completed task",
+  status: "DONE",
+  priority: "high",
+  owner: "CODER",
+  depends_on: [],
+  tags: ["code"],
+  verify: ["bun test"],
