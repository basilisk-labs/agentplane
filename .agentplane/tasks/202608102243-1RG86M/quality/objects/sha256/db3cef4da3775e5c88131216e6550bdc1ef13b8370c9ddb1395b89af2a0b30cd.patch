+    title: "Verification v2",
+    description: "Verification v2",
+    status: "DOING",
+    priority: "med",
+    owner: "CODER",
+    depends_on: [],
+    tags: ["code"],
+    verify: ["bun test"],
+    verification: {
+      state: "ok",
+      attempts: 0,
+      updated_at: RECORDED_AT,
