+  const ctx = { config: { ...defaultConfig(), workflow_mode: "branch_pr" } } as CommandContext;
+  const options = {
+    taskIds: [task.id],
+    author: "CODER",
+    quiet: true,
+    force: true,
+    commit: "c".repeat(40),
+    preMergeClosure: true,
+  } as FinishOptions;
+  const plan = {
+    primaryTaskId: task.id,
+    metaTaskId: task.id,
+    preMergeClosure: true,
+    shouldCloseCommit: true,
+    closeAdditionalTaskIds: [],
