{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentplane.org/schemas/agent-semantic-payload.schema.json",
  "title": "Agent semantic payload (PLANNER, planning)",
  "description": "Copy work_order_id from the issued WorkOrder. Return only this payload. The CLI binds it to that immutable episode and supplies its service fields. Keep summary short and report each finding once.",
  "definitions": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "number",
      "const": 1
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "repository_write",
        "documentation",
        "source_code",
        "tests",
        "public_api",
        "schema",
        "dependencies",
        "ci",
        "release_metadata",
        "security_boundary"
      ]
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/__schema4"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema4"
          }
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema4"
          }
        },
        "expected_outputs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema4"
          }
        },
        "execution_requirements": {
          "type": "object",
          "properties": {
            "scope_roots": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/__schema5"
                  }
                ]
              }
            },
            "repository_effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema5"
              }
            },
            "external_effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema5"
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema5"
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema5"
              }
            }
          },
          "required": [
            "scope_roots",
            "repository_effects",
            "external_effects",
            "capabilities",
            "resources"
          ],
          "additionalProperties": false
        },
        "optional": {
          "type": "boolean"
        },
        "contract": {
          "type": "object",
          "properties": {
            "objective": {
              "$ref": "#/definitions/__schema5"
            },
            "acceptance_criteria": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema5"
              }
            },
            "verification_commands": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema5"
              }
            },
            "role": {
              "type": "string",
              "enum": [
                "PLANNER",
                "CURATOR",
                "EXECUTOR",
                "EVALUATOR"
              ]
            }
          },
          "required": [
            "objective",
            "acceptance_criteria",
            "verification_commands",
            "role"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "depends_on",
        "required_inputs",
        "expected_outputs",
        "execution_requirements",
        "optional",
        "contract"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema5"
        }
      ]
    },
    "__schema5": {
      "type": "string",
      "minLength": 1
    }
  },
  "type": "object",
  "properties": {
    "work_order_id": {
      "$ref": "#/definitions/__schema0"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "needs_context",
        "failed"
      ]
    },
    "summary": {
      "$ref": "#/definitions/__schema0"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claimed_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "$ref": "#/definitions/__schema0"
          },
          "claimed_status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "details": {
            "allOf": [
              {
                "$ref": "#/definitions/__schema0"
              }
            ]
          }
        },
        "required": [
          "check",
          "claimed_status"
        ],
        "additionalProperties": false
      }
    },
    "blocker": {
      "type": "object",
      "properties": {
        "summary": {
          "$ref": "#/definitions/__schema0"
        },
        "recommended_action": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema0"
            }
          ]
        },
        "scope_extension_request": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "$ref": "#/definitions/__schema1"
                },
                "rationale": {
                  "$ref": "#/definitions/__schema0"
                },
                "scope_roots": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema0"
                  }
                },
                "repository_effects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema2"
                  }
                }
              },
              "required": [
                "schema_version",
                "rationale",
                "scope_roots",
                "repository_effects"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "$ref": "#/definitions/__schema1"
                },
                "rationale": {
                  "$ref": "#/definitions/__schema0"
                },
                "scope_roots": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema0"
                  }
                },
                "repository_effects": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema2"
                  }
                }
              },
              "required": [
                "schema_version",
                "rationale",
                "scope_roots",
                "repository_effects"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "knowledge_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "knowledge_request"
        },
        "query": {
          "$ref": "#/definitions/__schema0"
        },
        "reason": {
          "$ref": "#/definitions/__schema0"
        },
        "desired_kind": {
          "type": "string",
          "enum": [
            "any",
            "wiki",
            "source",
            "fact",
            "entity",
            "edge"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "task_context"
          ]
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "query",
        "reason",
        "desired_kind",
        "scope",
        "blocking"
      ],
      "additionalProperties": false
    },
    "canonical_plan": {
      "type": "object",
      "properties": {
        "work_items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema3"
          }
        }
      },
      "required": [
        "work_items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "work_order_id",
    "status",
    "summary",
    "findings",
    "uncertainty"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocker"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_context"
          }
        }
      },
      "then": {
        "required": [
          "knowledge_request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "canonical_plan"
        ]
      }
    }
  ],
  "examples": [
    {
      "work_order_id": "copy-the-issued-work-order-id",
      "status": "blocked",
      "summary": "The required input is unavailable.",
      "findings": [],
      "uncertainty": [],
      "blocker": {
        "summary": "Describe the concrete missing input."
      }
    }
  ]
}
