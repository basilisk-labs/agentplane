+  | "output";
+
+export type CommandPreparationNode = "project" | "config" | "command_context" | "output";
+
+export type CommandPreparationTrace = {
+  command: string;
+  capability: CommandCapability;
+  node: CommandPreparationNode;
+  status: "resolved" | "reused" | "denied" | "failed";
+  durationMs: number;
+};
