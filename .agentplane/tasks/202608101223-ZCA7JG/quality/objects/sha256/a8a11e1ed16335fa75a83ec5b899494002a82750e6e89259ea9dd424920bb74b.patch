+function sha256(value: string): `sha256:${string}` {
+  return `sha256:${createHash("sha256").update(value).digest("hex")}`;
+}
+
+function makeTask(taskId: string): TaskData {
+  return {
+    id: taskId,
+    title: "Task",
+    description: "Task",
+    status: "DOING",
