-        planProblem(
-          "plan_invalid_state_transition",
-          `Blueprint plan transition is not allowed by the selected blueprint graph: ${from} -> ${to}`,
-          `states.${index}`,
-        ),
-      );
-    }
-  }
-
-  return {
-    ok: errors.length === 0,
-    errors,
-  };
-}
