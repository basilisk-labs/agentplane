-  | "ops.approval";
-
-export type TaskKind = "analysis" | "content" | "docs" | "code" | "release" | "ops" | "context";
-
-export type WorkflowMode = "direct" | "branch_pr";
-
-export type BlueprintNodeKind =
-  | "intake"
-  | "scope"
-  | "context_resolve"
-  | "approval_gate"
-  | "worktree_start"
-  | "work_unit"
-  | "deterministic_check"
