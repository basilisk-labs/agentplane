-  | "verify_record"
-  | "quality_gate"
-  | "handoff"
-  | "finish";
-
-export type BlueprintNodeMode = "deterministic" | "agentic" | "approval" | "record";
-
-export type EvidenceKind =
-  | "sources"
-  | "assumptions"
-  | "context_manifest"
-  | "changed_paths"
-  | "check_result"
-  | "artifact"
-  | "approval"
-  | "external_link"
-  | "commit"
-  | "final_output"
-  | "weak_links"
-  | "quality_report"
-  | "rollback";
-
-export type Blueprint = {
-  id: BlueprintId;
-  version: 1;
-  title: string;
-  description: string;
-  taskKinds: TaskKind[];
-  workflowModes?: WorkflowMode[];
-  nodes: BlueprintNode[];
-  edges: BlueprintEdge[];
-  requiredEvidence: EvidenceRequirement[];
-  stopRules: StopRule[];
-  recipeExtensionPoints?: RecipeExtensionPoint[];
-};
-
-export type BlueprintNode = {
