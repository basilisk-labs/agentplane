-  }
-
-  let content: string;
-  try {
-    content = await readContainedStableTextNoFollow({
-      repository_root: opts.repositoryRoot,
-      file_path: path.join(opts.repositoryRoot, opts.relativePath),
-      label: "workflow_route_blueprint",
-      max_bytes: BLUEPRINT_MAX_BYTES,
