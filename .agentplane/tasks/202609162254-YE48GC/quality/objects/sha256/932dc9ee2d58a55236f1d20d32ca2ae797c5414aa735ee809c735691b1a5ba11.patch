-
-export type BlueprintEdge = {
-  from: string;
-  to: string;
-  condition?: string;
-};
-
-export type EvidenceRequirement = {
-  id: string;
-  kind: EvidenceKind;
-  required: boolean;
-  producedBy: string;
-  description: string;
