+  const selected = relativePath ?? DEFAULT_COMPATIBILITY_CANDIDATE_PATH;
+  if (
+    typeof selected !== "string" ||
+    !/^scripts\/baselines\/[A-Za-z0-9][A-Za-z0-9._-]*-compatibility-candidate\.json$/u.test(
